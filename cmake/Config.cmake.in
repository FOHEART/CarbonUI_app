include(CMakeFindDependencyMacro)

# 如果你的库依赖其他包，可在这里 use find_dependency()
# find_dependency(SomeDep REQUIRED)

# 导入安装时生成的 targets 文件（与 install(EXPORT ...) 中的 FILE 名称一致）
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

# 可选：向使用者暴露一些兼容性变量
set(@PROJECT_NAME@_INCLUDE_DIRS "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_NAME}")
set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@::${PROJECT_NAME})

